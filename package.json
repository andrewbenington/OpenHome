{
  "productName": "OpenHome",
  "name": "openhome",
  "version": "1.18.1",
  "description": "A tool for moving Pokémon between game saves",
  "keywords": [
    "pokemon",
    "home",
    "openhome"
  ],
  "homepage": "https://github.com/andrewbenington/OpenHome#readme",
  "bugs": {
    "url": "https://github.com/andrewbenington/OpenHome/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewbenington/OpenHome.git"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=v24.22.1"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Andrew Benington",
    "email": "andrewbenington57@gmail.com"
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "scripts/*",
    "test/*"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "prettier --write .",
    "lint": "eslint src --max-warnings 0 --report-unused-disable-directives -c eslint.config.mjs --fix && pnpm clippy",
    "lint:ci": "eslint src --max-warnings 0 --report-unused-disable-directives -c eslint.config.mjs && pnpm clippy",
    "clippy": "cargo clippy --all-targets --all-features --profile test -- -Dwarnings",
    "typecheck": "tsgo",
    "build": "pnpm wasm-compile && pnpm vite build",
    "ui-test-build": "pnpm tauri build --no-bundle --config src-tauri/tauri.uitest.conf.json -- --features=uitest",
    "dev": "pnpm wasm-compile-dev && pnpm vite",
    "tauri": "tauri",
    "test-cargo": "cargo nextest run --workspace --all-features --no-fail-fast",
    "test-cargo:ci": "cargo nextest run --workspace --all-features",
    "test-vite": "pnpm wasm-compile-dev && vitest run",
    "test": "pnpm test-cargo && pnpm test-vite",
    "test:ci": "pnpm test-cargo:ci && pnpm test-vite",
    "wasm-compile-dev": "wasm-pack build --dev  --panic-unwind ./pkm_rs --target web -- --features wasm && node scripts/patch-types.mjs",
    "wasm-compile": "wasm-pack build --release ./pkm_rs --target web -- --features wasm && node scripts/patch-types.mjs",
    "precommit": "pnpm typecheck && pnpm format && pnpm lint",
    "postinstall": "pnpm wasm-compile-dev",
    "ui-test": "./scripts/run-ui-tests.sh",
    "wdio": "UI_TEST_DATA_FOLDER='ui-tests/ui-tests-data-dir' wdio run ./wdio.conf.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/collision": "^0.5.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/react": "^0.5.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "chart.js": "^4.6.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "immer": "^11.2.9",
    "prando": "^6.0.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-data-grid": "7.0.0-beta.61",
    "react-error-boundary": "^6.1.6",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.0",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table-devtools": "^9.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "@wdio/types": "^10.1.0",
    "better-sqlite3": "^13.0.3",
    "camelcase-keys": "^10.0.3",
    "chalk": "^6.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^10.2.1",
    "expect-webdriverio": "^7.0.1",
    "globby": "^16.2.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "^9.32.0"
  }
}
