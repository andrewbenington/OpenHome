# Originally written by https://github.com/coolguygus as part of a larger PR

# Merge strategies for specific files
# This helps Git handle conflicts more intelligently

# always keep, never merge (regenerated lockfiles)
pnpm-lock.yaml merge=ours
flake.lock merge=ours
yarn.lock merge=ours
Cargo.lock merge=ours

# Line ending normalization
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rs text eol=lf

# Binary files
*.pkm binary
*.pk1 binary
*.pk2 binary
*.pk3 binary
*.ck3 binary
*.colopkm binary
*.xk3 binary
*.xdpkm binary
*.pk4 binary
*.pk5 binary
*.pk6 binary
